# Supabase project (Project Settings -> API). Use the anon / publishable key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deployed Express API origin, e.g. https://bizwise-api.vercel.app (no trailing slash).
# Leave blank in local development to use the Vite proxy on /api.
VITE_API_BASE_URL=

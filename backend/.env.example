# Supabase project (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider. Only "gemini" is supported today.
AI_PROVIDER=gemini
# Gemini API key from https://aistudio.google.com/app/apikey (server-side only)
AI_API_KEY=
# Model used for advisor answers and dashboard insights (default: gemini-3.5-flash).
# Older models such as gemini-2.5-flash are rejected for new API keys.
AI_MODEL=gemini-3.5-flash
# Used automatically when the primary model is rate limited or reports high demand.
AI_MODEL_FALLBACK=gemini-3.5-flash-lite

# Comma separated list of allowed browser origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# Local development port
PORT=8787

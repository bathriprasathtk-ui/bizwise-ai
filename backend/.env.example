# Supabase project (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider. Only "gemini" is supported today.
AI_PROVIDER=gemini
# Gemini API key from https://aistudio.google.com/app/apikey (server-side only)
AI_API_KEY=
# Optional model override, defaults to gemini-2.5-flash
AI_MODEL=

# Comma separated list of allowed browser origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# Local development port
PORT=8787
